{
  "name": "vitanex-ai",
  "version": "1.0.0",
  "type": "module",
  "description": "VitaNex AI — Personal Health Copilot for managing health records, appointments, and wellness insights",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --verbose --forceExit",
    "predeploy": "mkdir dist 2>nul || true && xcopy /s /e /y public dist\\ && copy index.html dist\\",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.4",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "marked": "^11.1.0",
    "morgan": "^1.10.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
